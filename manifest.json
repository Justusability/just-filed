{
  "manifest_version": 3,
  "name": "Just Filed: AI bookmark folders",
  "short_name": "Just Filed",
  "version": "1.0.2",
  "description": "File any bookmark in seconds: type to find a folder or make a new one, with on-device AI suggestions. Nothing leaves your browser.",
  "author": "Justusability",
  "homepage_url": "https://www.justusability.com/",
  "minimum_chrome_version": "127",
  "permissions": [
    "bookmarks",
    "storage",
    "activeTab",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open Just Filed"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Just Filed",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
